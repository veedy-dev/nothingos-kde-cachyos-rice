{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.local/share/fastfetch/images/cachyos-nothing-white.png",
    "type": "kitty",
    "height": 18,
    "padding": { "top": 2, "right": 3, "left": 1 }
  },
  "display": {
    "separator": "  ·  ",
    "color": { "keys": "white", "separator": "bright_black" }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "N O T H I N G  /  K D E", "outputColor": "white" },
    { "type": "custom", "format": "────────────────────────", "outputColor": "bright_black" },
    "break",
    { "type": "os",       "key": "SYSTEM" },
    { "type": "kernel",   "key": "  ├ KERNEL" },
    { "type": "packages", "key": "  ├ PACKAGES" },
    { "type": "shell",    "key": "  └ SHELL" },
    "break",
    { "type": "de",       "key": "DESKTOP" },
    { "type": "wm",       "key": "  ├ COMPOSITOR" },
    { "type": "wmtheme",  "key": "  ├ THEME" },
    { "type": "icons",    "key": "  ├ ICONS" },
    { "type": "cursor",   "key": "  └ CURSOR" },
    "break",
    { "type": "custom",   "format": "HARDWARE", "outputColor": "white" },
    { "type": "cpu",      "key": "  ├ CPU" },
    { "type": "gpu",      "key": "  ├ GPU" },
    { "type": "memory",   "key": "  ├ MEMORY" },
    { "type": "disk",     "key": "  └ DISK", "folders": "/" },
    "break",
    { "type": "display",  "key": "DISPLAY", "compactType": "original-with-refresh-rate" },
    "break",
    "colors"
  ]
}
